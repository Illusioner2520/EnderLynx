{
  "name": "EnderLynx",
  "version": "0.11.5",
  "main": "main.js",
  "scripts": {
    "start": "npm run prepare-electron && electron-forge start",
    "make": "electron-forge make",
    "installer:windows": "makensis installer/installer.nsi",
    "updater:windows": "cd updater && cargo build --release && cd .. && copy updater\\target\\release\\updater.exe up.exe",
    "build:windows": "npm run prepare-electron && npm run updater:windows && npm run make && npm run installer:windows",
    "build:linux": "npm run prepare-electron && npm run make",
    "build:macos": "npm run prepare-electron && npm run make",
    "prepare-electron": "install-electron"
  },
  "author": "Illusioner",
  "license": "MIT",
  "description": "The best Minecraft launcher.",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.4.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "ace-builds": "^1.43.6",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "create-desktop-shortcuts": "^1.11.1",
    "discord-rpc": "^4.0.1",
    "electron-window-state": "^5.0.3",
    "form-data": "^4.0.6",
    "markdown-it": "^14.3.0",
    "msmc": "^5.0.5",
    "p-limit": "^7.3.0",
    "png-to-ico": "^3.0.1",
    "prismarine-nbt": "^2.8.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "skinview3d": "^3.4.1",
    "string-argv": "^0.3.2",
    "toml": "^3.0.0",
    "winreg": "^1.2.5"
  }
}
